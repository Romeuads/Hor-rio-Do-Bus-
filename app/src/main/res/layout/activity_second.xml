<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frosted_second_bg">

    <!-- Top Centered Content: Title, Circle Badge, and Back Button -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:fitsSystemWindows="true"
        android:paddingTop="36dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Title "Segunda Tela" -->
        <TextView
            android:id="@+id/segunda_tela_title"
            android:tag="segunda_tela_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/segunda_tela"
            android:textColor="@color/frosted_second_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Decorative Frosted Circular Badge with Bus Icon -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="36dp"
            android:background="@drawable/bg_second_bus_circle"
            android:elevation="6dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_directions_bus"
                android:tint="@color/frosted_second_bus_tint"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Button "voltar" -->
        <LinearLayout
            android:id="@+id/voltar_button"
            android:tag="voltar_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="180dp"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_button_second"
            android:clickable="true"
            android:focusable="true"
            android:elevation="6dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/white"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/voltar"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Footer Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:fitsSystemWindows="true"
        android:layout_marginBottom="24dp"
        android:text="@string/sistema_horarios_integrado"
        android:textColor="@color/frosted_second_text_muted"
        android:textStyle="italic"
        android:textSize="13sp" />

</FrameLayout>
