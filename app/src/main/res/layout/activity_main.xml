<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Highway Wallpaper Background -->
    <ImageView
        android:id="@+id/img_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img_highway_wallpaper"
        android:contentDescription="@string/background_description" />

    <!-- Frosted Glass Midnight Gradient Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_highway_scrim" />

    <!-- Top Centered Container: Title and Next Screen Button -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:fitsSystemWindows="true"
        android:paddingTop="36dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Title "Primeira Tela" in Frosted Glass Capsule -->
        <TextView
            android:id="@+id/primeira_tela_title"
            android:tag="primeira_tela_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/primeira_tela"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/bg_frosted_title"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:elevation="6dp" />

        <!-- Button "Próxima tela" Pill -->
        <LinearLayout
            android:id="@+id/proxima_tela_button"
            android:tag="proxima_tela_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_frosted_pill"
            android:clickable="true"
            android:focusable="true"
            android:elevation="8dp"
            android:paddingStart="28dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/proxima_tela"
                android:textColor="@color/frosted_pill_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_arrow_forward"
                android:tint="@color/frosted_pill_text"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Left Container: Two buttons one below the other -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="32dp">

        <!-- Button "jotur" -->
        <LinearLayout
            android:id="@+id/jotur_button"
            android:tag="jotur_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="190dp"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_frosted_card"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_directions_bus"
                android:tint="@color/white"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="12dp"
                android:text="JOTUR"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_open_in_browser"
                android:tint="#CCFFFFFF"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Button "Consórcio Fenix" -->
        <LinearLayout
            android:id="@+id/consorcio_fenix_button"
            android:tag="consorcio_fenix_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minWidth="190dp"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_frosted_card"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_directions_bus"
                android:tint="@color/white"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="12dp"
                android:text="CONSÓRCIO FENIX"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_open_in_browser"
                android:tint="#CCFFFFFF"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
